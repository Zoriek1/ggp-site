# Copie para web/.env.local. Nunca versione credenciais.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Desenvolvimento: leitura local; habilite a escrita somente para testes locais.
CONTENT_DRIVER=local
CONTENT_ALLOW_LOCAL_WRITES=false
# Caminho absoluto para a raiz do projeto; vazio usa o diretório acima de web/.
CONTENT_ROOT=

# Produção: CONTENT_DRIVER=github e token granular limitado a este repositório.
GITHUB_REPOSITORY=Zoriek1/ggp-site
GITHUB_BRANCH=main
GITHUB_TOKEN=

# Caminhos absolutos e persistentes são obrigatórios na implantação.
MEDIA_DIR=../.runtime/media
CONTENT_CACHE_DIR=../.runtime/cache
BACKUP_DIR=../.runtime/backups

# Gere os valores conforme docs/DEPLOY.md. Sem credenciais, o painel não permite entrar.
SESSION_SECRET=
PANEL_USERS_JSON=[]
